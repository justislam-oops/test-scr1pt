local function buildCombat()
    sectionLabel(Tabs.combat, "AIM")

    makeToggle(Tabs.combat, "SilentAim", "SilentAimDesc", State.SilentAimEnabled, setSilentAim)
    makeToggle(Tabs.combat, "AimAssist", "AimAssistDesc", State.AimAssistEnabled, setAimAssist)
    makeToggle(Tabs.combat, "AimHold", "AimHoldDesc", Config.AimAssistHoldRMB, function(on)
        Config.AimAssistHoldRMB = on
        saveConfig()
    end)

    makeSlider(Tabs.combat, "FOV", "FOVDesc", 10, 400, Config.SilentAimFOV, "px", function(v)
        Config.SilentAimFOV = v
        LastFovRadius = nil
        saveConfig()
    end)

    makeDropdown(Tabs.combat, "FOVPreset", "FOVPresetDesc", {
        { key = "Small", label = "PresetSmall" },
        { key = "Medium", label = "PresetMedium" },
        { key = "Large", label = "PresetLarge" },
        { key = "Ultra", label = "PresetUltra" },
    }, Config.FOVPreset, function(key)
        Config.FOVPreset = key
        Config.SilentAimFOV = FOV_PRESETS[key] or Config.SilentAimFOV
        LastFovRadius = nil
        saveConfig()
        rebuildUI()
    end)

    makeDropdown(Tabs.combat, "HitPart", "HitPartDesc", {
        { key = "Head", label = "PartHead" },
        { key = "Torso", label = "PartTorso" },
        { key = "HumanoidRootPart", label = "PartRoot" },
        { key = "Nearest", label = "PartNearest" },
        { key = "Random", label = "PartRandom" },
    }, Config.SilentAimPart, function(key)
        Config.SilentAimPart = key
        saveConfig()
    end)

    makeSlider(Tabs.combat, "AimSmooth", "AimSmoothDesc", 1, 100, math.floor(Config.AimAssistSmooth * 100), "%", function(v)
        Config.AimAssistSmooth = v / 100
