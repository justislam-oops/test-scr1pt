        BackgroundColor3 = COLORS.Accent,
        BackgroundTransparency = 0.94,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 1,
    }, ScreenGui)
    addCorner(FovCircle, 1000)
    FovStroke = addStroke(FovCircle, COLORS.Accent, 1.6, 0.15)

    TargetStatus = create("TextLabel", {
        Name = "_" .. randomString(8),
        AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 340, 0, 20),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = "",
        TextColor3 = COLORS.Text,
        TextSize = 12,
        TextStrokeTransparency = 0.5,
        Visible = false,
        ZIndex = 2,
    }, ScreenGui)

    FovInfoLabel = create("TextLabel", {
        Name = "_" .. randomString(8),
        AnchorPoint = Vector2.new(0.5, 1),
        Position = UDim2.new(0.5, 0, 0.5, -10),
        Size = UDim2.new(0, 320, 0, 16),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        Text = "",
        TextColor3 = COLORS.TextDim,
        TextSize = 11,
        TextStrokeTransparency = 0.6,
        Visible = false,
        ZIndex = 2,
    }, ScreenGui)

    TargetMarker = create("Frame", {
        Name = "_" .. randomString(8),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.new(0, 26, 0, 26),
        BackgroundTransparency = 1,
        Visible = false,
        ZIndex = 3,
    }, ScreenGui)
    local mk = create("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, TargetMarker)
    addCorner(mk, 13)
    addStroke(mk, COLORS.Red, 2, 0)
end

local hudConn = nil
local lastHud = 0

local function hudStep()
    local clockNow = os.clock()
    if clockNow - lastHud < 0.05 then return end
    lastHud = clockNow

    local showFov = Config.ShowFov and (State.SilentAimEnabled or State.AimAssistEnabled)
    FovCircle.Visible = showFov
    TargetStatus.Visible = showFov
    FovInfoLabel.Visible = showFov

    if showFov then
        local vp = Camera.ViewportSize
        local radius = getFovRadius(Config.SilentAimFOV)
        if LastFovRadius ~= radius or LastViewport ~= vp then
            LastFovRadius = radius
            LastViewport = vp
            FovCircle.Size = UDim2.new(0, radius * 2, 0, radius * 2)
            FovCircle.Position = UDim2.new(0, vp.X * 0.5, 0, vp.Y * 0.5)
            TargetStatus.Position = UDim2.new(0, vp.X * 0.5, 0, vp.Y * 0.5 + radius + 8)
            FovInfoLabel.Position = UDim2.new(0, vp.X * 0.5, 0, vp.Y * 0.5 - radius - 8)
        end

        local list = findTargets(State.AimAssistEnabled and "AimAssist" or "SilentAim")
        local target = currentTarget
        if not State.SilentAimEnabled then target = list[1] end

        local name = (target and target.plr) and target.plr.Name or nil
        if name ~= LastTargetName then
            LastTargetName = name
            local col = name and COLORS.Green or COLORS.Accent
            tween(FovCircle, 0.15, { BackgroundColor3 = col })
            tween(FovStroke, 0.15, { Color = col })
            TargetStatus.Text = name and (L("TargetLabel") .. ": " .. name) or L("NoTarget")
            TargetStatus.TextColor3 = col
        end
        FovInfoLabel.Text = L("TargetInfo") .. ": " .. #list .. "   |   FOV: " .. Config.SilentAimFOV
    end

    -- Target marker (FIX: раньше тоггл ничего не делал)
    if State.TargetMarkerEnabled then
        local t = currentTarget or findTarget(State.AimAssistEnabled and "AimAssist" or "SilentAim")
        if t and t.part and t.part.Parent then
            local sp, onScreen = Camera:WorldToViewportPoint(t.part.Position)
            if onScreen then
                TargetMarker.Visible = true
                TargetMarker.Position = UDim2.new(0, sp.X, 0, sp.Y)
            else
                TargetMarker.Visible = false
            end
        else
            TargetMarker.Visible = false
        end
    else
        TargetMarker.Visible = false
    end
end

--=====================================================================
