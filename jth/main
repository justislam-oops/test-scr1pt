local function buildInfo()
    sectionLabel(Tabs.info, L("Info"))

    -- stats row
    local statRow = create("Frame", {
        Size = UDim2.new(1, 0, 0, 62),
        BackgroundTransparency = 1,
    }, Tabs.info)
    local rl = Instance.new("UIListLayout")
    rl.FillDirection = Enum.FillDirection.Horizontal
    rl.Padding = UDim.new(0, 8)
    rl.Parent = statRow

    local function statCard(titleText, valueText)
        local card = create("Frame", {
            Size = UDim2.new(0.333, -6, 1, 0),
            BackgroundColor3 = COLORS.Card,
            BorderSizePixel = 0,
        }, statRow)
        addCorner(card, 10)
        addStroke(card, COLORS.Border, 1, 0.45)
        create("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 12, 0, 10),
            Size = UDim2.new(1, -24, 0, 14),
            Font = Enum.Font.GothamMedium,
            Text = string.upper(titleText),
            TextColor3 = COLORS.TextDim,
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, card)
        local v = create("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 12, 0, 26),
            Size = UDim2.new(1, -24, 0, 24),
            Font = Enum.Font.GothamBold,
            Text = valueText,
            TextColor3 = COLORS.Text,
            TextSize = 15,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
        }, card)
        return v
    end

    statCard(L("StatPlayer"), LP.Name)
    local pingVal = statCard(L("StatPing"), "--")
    local plrVal = statCard(L("StatPlayers"), tostring(#Players:GetPlayers()))

    task.spawn(function()
        while ScreenGui and ScreenGui.Parent do
            local ping = 0
            pcall(function() ping = math.floor((LP:GetNetworkPing() or 0) * 1000) end)
            if pingVal.Parent then pingVal.Text = ping .. " ms" end
            if plrVal.Parent then plrVal.Text = tostring(#Players:GetPlayers()) end
            task.wait(2)
        end
    end)

    -- telegram card
    local frame = create("Frame", {
        Size = UDim2.new(1, 0, 0, 76),
        BackgroundColor3 = COLORS.Card,
        BorderSizePixel = 0,
    }, Tabs.info)
    addCorner(frame, 10)
    addStroke(frame, COLORS.Accent, 1, 0.6)
    addGradient(frame, Color3.fromRGB(26, 34, 48), Color3.fromRGB(20, 24, 32), 25)

    create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 12),
        Size = UDim2.new(0.6, 0, 0, 22),
        Font = Enum.Font.GothamBold,
        Text = L("Telegram"),
        TextColor3 = COLORS.Text,
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, frame)
    create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 36),
        Size = UDim2.new(0.62, 0, 0, 24),
        Font = Enum.Font.GothamMedium,
        Text = L("TelegramSub") .. "  •  t.me/wettixy",
        TextColor3 = COLORS.Accent,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, frame)

    local btn = create("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -14, 0.5, 0),
        Size = UDim2.new(0, 132, 0, 36),
        BackgroundColor3 = COLORS.AccentDark,
        BorderSizePixel = 0,
        Font = Enum.Font.GothamBold,
        Text = L("CopyTG"),
        TextColor3 = COLORS.Text,
        TextSize = 12,
        AutoButtonColor = false,
    }, frame)
    addCorner(btn, 8)
    addGradient(btn, COLORS.Accent, COLORS.Accent2, 0)
    connect(btn.MouseEnter, function() tween(btn, 0.15, { Size = UDim2.new(0, 140, 0, 38) }) end)
    connect(btn.MouseLeave, function() tween(btn, 0.15, { Size = UDim2.new(0, 132, 0, 36) }) end)
    connect(btn.MouseButton1Click, function()
        local setCb = (type(setclipboard) == "function" and setclipboard) or (type(toclipboard) == "function" and toclipboard)
        if setCb then
            local ok = pcall(setCb, "https://t.me/wettixy")
            notify(ok and L("TGCopied") or L("CopyFail"))
        else
            notify(L("CopyFail"))
        end
    end)

    sectionLabel(Tabs.info, L("Reviews"))

    local reviews = {
        { date = "22.01.2026 13:33", key = "Review1" },
        { date = "28.01.2026 18:34", key = "Review2" },
        { date = "28.01.2026 22:12", key = "Review3" },
