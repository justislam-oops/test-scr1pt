local function buildSettings(keyChip)
    sectionLabel(Tabs.settings, L("Settings"))

    makeDropdown(Tabs.settings, "Language", "LanguageDesc", {
        { key = "RU", label = "LangRU" },
        { key = "EN", label = "LangEN" },
    }, CurrentLang, function(key)
        if key == CurrentLang then return end
        CurrentLang = key
        Config.Language = key
        saveConfig()
        rebuildUI() -- FIX: язык применяется сразу, без перезапуска
    end)

    -- keybind
    local frame, stroke = baseCard(Tabs.settings, 92)
    hoverCard(frame, stroke)
    create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 8),
        Size = UDim2.new(1, -32, 0, 20),
        Font = Enum.Font.GothamBold,
        Text = L("Keybind"),
        TextColor3 = COLORS.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, frame)
    create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 28),
        Size = UDim2.new(1, -32, 0, 18),
        Font = Enum.Font.Gotham,
        Text = L("KeybindDesc"),
        TextColor3 = COLORS.TextDim,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, frame)
    local keyBtn = create("TextButton", {
        Position = UDim2.new(0, 16, 0, 50),
        Size = UDim2.new(1, -32, 0, 32),
        BackgroundColor3 = COLORS.Header,
        BorderSizePixel = 0,
        Font = Enum.Font.GothamBold,
        Text = MenuKey.Name,
        TextColor3 = COLORS.Accent,
        TextSize = 13,
        AutoButtonColor = false,
    }, frame)
    addCorner(keyBtn, 7)
    addStroke(keyBtn, COLORS.Border, 1, 0.3)
    keyButtonRef = keyBtn
    connect(keyBtn.MouseButton1Click, function()
        waitingForKey = true
        keyBtn.Text = L("KeybindWaiting")
        keyBtn.TextColor3 = COLORS.Yellow
    end)

    makeToggle(Tabs.settings, "AntiAfk", "AntiAfkDesc", Config.AntiAfkEnabled, setAntiAfk)

    makeButton(Tabs.settings, "Unload", "UnloadDesc", "UnloadBtn", Color3.fromRGB(150, 40, 55), function()
        if type(getgenv) == "function" and type(getgenv().JustTeamUnload) == "function" then
            getgenv().JustTeamUnload()
        end
    end)
end

--=====================================================================
-- BUILD / REBUILD
--=====================================================================
local keyChipRef = nil

local function buildAll()
    keyChipRef = buildGui()
    buildHud()
    buildWatermark()
    buildInfo()
    buildCombat()
    buildVisual()
    buildSettings(keyChipRef)

    if hudConn then hudConn:Disconnect() end
    hudConn = RunService.RenderStepped:Connect(hudStep)

    setMenuOpen(true, false)
end

rebuildUI = function()
    task.spawn(function()
        local oldGui = ScreenGui
        local espWasOn = State.ESPEnabled

        if hudConn then hudConn:Disconnect(); hudConn = nil end
        for plr, _ in pairs(ESPData) do destroyESP(plr) end
        ESPData = {}

        if oldGui then pcall(function() oldGui:Destroy() end) end
        Tabs = {}
        keyButtonRef = nil

        buildAll()
        if espWasOn then refreshAllESP() end
    end)
end

buildAll()

--=====================================================================
-- KEYBIND / MENU TOGGLE
--=====================================================================
connect(UserInputService.InputBegan, function(input, gpe)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if waitingForKey then
        waitingForKey = false
        MenuKey = input.KeyCode
        Config.MenuKeyName = input.KeyCode.Name
        if keyButtonRef and keyButtonRef.Parent then
            keyButtonRef.Text = MenuKey.Name
            keyButtonRef.TextColor3 = COLORS.Accent
        end
        if keyChipRef and keyChipRef.Parent then keyChipRef.Text = "MENU: " .. MenuKey.Name end
        saveConfig()
        notify(L("ConfigSaved"))
        return
    end

    if gpe then return end
    if input.KeyCode == MenuKey then
        setMenuOpen(not menuOpen, false)
    end
end)

--=====================================================================
-- DEATH / RESPAWN HANDLING
--=====================================================================
local function rememberFeatures()
    State.WasEnabledBeforeDeath = {
        SilentAim = State.SilentAimEnabled,
        AimAssist = State.AimAssistEnabled,
        ESP = State.ESPEnabled,
        Speed = State.SpeedEnabled,
        Fly = State.FlyEnabled,
        Noclip = State.NoclipEnabled,
        InfiniteJump = State.InfiniteJumpEnabled,
    }
end

local function disableAllFeatures()
    setSilentAim(false)
    setAimAssist(false)
    setESP(false)
    setSpeed(false)
    setFly(false)
    setNoclip(false)
    setJump(false)
end

local function restoreFeatures()
    local w = State.WasEnabledBeforeDeath
    if not w then return end
    if w.SilentAim then setSilentAim(true) end
    if w.AimAssist then setAimAssist(true) end
    if w.ESP then setESP(true) end
    if w.Speed then setSpeed(true) end
    if w.Fly then setFly(true) end
    if w.Noclip then setNoclip(true) end
    if w.InfiniteJump then setJump(true) end
end

local function hookCharacter(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
    if not hum then return end
    connect(hum.Died, function()
        rememberFeatures()
        disableAllFeatures()
        notify(L("DeathDisabled"))
    end)
end

if LP.Character then hookCharacter(LP.Character) end

connect(LP.CharacterAdded, function(char)
    task.wait(0.5)
    updateRayFilter()
    hookCharacter(char)
    task.wait(1.5)
    if next(State.WasEnabledBeforeDeath or {}) ~= nil then
        restoreFeatures()
        notify(L("RespawnEnabled"))
        State.WasEnabledBeforeDeath = {}
    end
    if State.ESPEnabled then refreshAllESP() end
end)

--=====================================================================
-- ANTI-DETECTION: PERIODIC RENAME
--=====================================================================
task.spawn(function()
    while ScreenGui and ScreenGui.Parent do
        task.wait(30)
        for _, data in pairs(ESPData) do
            if data.highlight and data.highlight.Parent then data.highlight.Name = "_" .. randomString(8) end
            for _, key in ipairs({ "box", "name", "health", "distance" }) do
                local obj = data[key]
                if type(obj) == "table" and obj.gui and obj.gui.Parent then
                    obj.gui.Name = "_" .. randomString(8)
                end
            end
        end
    end
end)

--=====================================================================
-- CLEANUP / UNLOAD
--=====================================================================
local function fullCleanup()
    disconnectAll()
    pcall(function() RunService:UnbindFromRenderStep(SILENT_PRE) end)
    pcall(function() RunService:UnbindFromRenderStep(SILENT_POST) end)
    if aimAssistConn then aimAssistConn:Disconnect(); aimAssistConn = nil end
    if speedConn then speedConn:Disconnect(); speedConn = nil end
    if jumpConn then jumpConn:Disconnect(); jumpConn = nil end
    if espUpdateConn then espUpdateConn:Disconnect(); espUpdateConn = nil end
    if hudConn then hudConn:Disconnect(); hudConn = nil end

    setNoclip(false)
    setFly(false)

    for plr, _ in pairs(ESPData) do destroyESP(plr) end
    ESPData = {}
    silentPost()
end

connect(ScreenGui.Destroying, function()
    fullCleanup()
end)

getgenv().JustTeamUnload = function()
    fullCleanup()
    if ScreenGui then pcall(function() ScreenGui:Destroy() end) end
    ScreenGui = nil
    getgenv().JUSTTEAM_AUTHED = nil
    getgenv().JUSTTEAM_SEAL = nil
    getgenv().JustTeamUnload = nil
    notify("Unloaded")
end

notify("JustTeam v4.0.3 loaded | " .. MenuKey.Name)

