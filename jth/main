local SECRET = "4a156cbd-7be0-4ec3-a6fe-0dcce4d61f50"
local GUI_PREFIX = "JustTeamV40_"

local function _fail(reason)
    warn("[JustTeam] " .. tostring(reason))
    local ok, sg = pcall(function() return game:GetService("CoreGui") end)
    if ok and sg then
        for _, g in ipairs(sg:GetChildren()) do
            if string.sub(g.Name, 1, #GUI_PREFIX) == GUI_PREFIX then
                pcall(function() g:Destroy() end)
            end
        end
    end
    if type(gethui) == "function" then
        local ok2, hui = pcall(gethui)
        if ok2 and hui then
            for _, g in ipairs(hui:GetChildren()) do
                if string.sub(g.Name, 1, #GUI_PREFIX) == GUI_PREFIX then
                    pcall(function() g:Destroy() end)
                end
            end
        end
    end
    if type(getgenv) == "function" then
        local env = getgenv()
        env.JUSTTEAM_AUTHED = nil
        env.JUSTTEAM_HWID = nil
        env.JUSTTEAM_TOKEN = nil
        env.JUSTTEAM_SEAL = nil
        env.JUSTTEAM_LOADED_AT = nil
    end
end

if type(getgenv) ~= "function" then return _fail("getgenv unavailable") end
local env = getgenv()
if env.JUSTTEAM_AUTHED ~= true then return _fail("Unauthorized") end
if not env.JUSTTEAM_HWID or env.JUSTTEAM_HWID == "" then return _fail("HWID missing") end
if not env.JUSTTEAM_TOKEN or #tostring(env.JUSTTEAM_TOKEN) < 32 then return _fail("Token invalid") end
if type(env.JUSTTEAM_LOADED_AT) ~= "number" then return _fail("Timestamp invalid") end

local now = os.time()
if now - env.JUSTTEAM_LOADED_AT > 300 then return _fail("Session expired") end
if now < env.JUSTTEAM_LOADED_AT - 5 then return _fail("Clock manipulation") end

local currentHwid = nil
if type(gethwid) == "function" then
    local ok, r = pcall(gethwid)
    if ok and r and r ~= "" then currentHwid = tostring(r) end
end
if not currentHwid and type(get_hwid) == "function" then
    local ok, r = pcall(get_hwid)
    if ok and r and r ~= "" then currentHwid = tostring(r) end
end
if not currentHwid then
    local ok, lp = pcall(function() return game:GetService("Players").LocalPlayer end)
    if ok and lp then currentHwid = tostring(lp.UserId) end
end
if not currentHwid then return _fail("Cannot resolve HWID") end
if currentHwid ~= tostring(env.JUSTTEAM_HWID) then return _fail("HWID mismatch") end
if not env.JUSTTEAM_SEAL then return _fail("Seal missing") end

--=====================================================================
-- BITWISE / SHA-256
--=====================================================================
local band, bxor, bor, rshift, lshift, bnot
if bit32 then
    band = bit32.band; bxor = bit32.bxor; bor = bit32.bor
    rshift = bit32.rshift; lshift = bit32.lshift; bnot = bit32.bnot
else
    band = function(a, b) local r, bit = 0, 1 while a > 0 and b > 0 do if a % 2 == 1 and b % 2 == 1 then r = r + bit end a = math.floor(a / 2); b = math.floor(b / 2); bit = bit * 2 end return r end
    bxor = function(a, b) local r, bit = 0, 1 while a > 0 or b > 0 do if (a % 2) ~= (b % 2) then r = r + bit end a = math.floor(a / 2); b = math.floor(b / 2); bit = bit * 2 end return r end
    bor = function(a, b) local r, bit = 0, 1 while a > 0 or b > 0 do if a % 2 == 1 or b % 2 == 1 then r = r + bit end a = math.floor(a / 2); b = math.floor(b / 2); bit = bit * 2 end return r end
    rshift = function(a, n) return math.floor(a / (2 ^ n)) % 4294967296 end
    lshift = function(a, n) return (a * (2 ^ n)) % 4294967296 end
    bnot = function(a) return 4294967295 - (a % 4294967296) end
end

local K = {
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
}

local function rrot(x, n)
    x = x % 4294967296
    return bor(rshift(x, n), lshift(x, 32 - n)) % 4294967296
end

local function sha256_pure(msg)
    local H = { 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19 }
    local msgLen = #msg
    local pad = (56 - (msgLen + 1) % 64) % 64
    msg = msg .. string.char(128) .. string.rep(string.char(0), pad)
    local bits = msgLen * 8
    local hi = math.floor(bits / 4294967296)
    local lo = bits % 4294967296
    msg = msg .. string.char(
        math.floor(hi / 16777216) % 256, math.floor(hi / 65536) % 256, math.floor(hi / 256) % 256, hi % 256,
        math.floor(lo / 16777216) % 256, math.floor(lo / 65536) % 256, math.floor(lo / 256) % 256, lo % 256
    )
    for chunk = 1, #msg, 64 do
        local w = {}
        for i = 0, 15 do
            local base = chunk + i * 4
            w[i + 1] = string.byte(msg, base) * 16777216
                + string.byte(msg, base + 1) * 65536
                + string.byte(msg, base + 2) * 256
                + string.byte(msg, base + 3)
        end
        for i = 17, 64 do
            local s0 = bxor(bxor(rrot(w[i - 15], 7), rrot(w[i - 15], 18)), rshift(w[i - 15], 3))
            local s1 = bxor(bxor(rrot(w[i - 2], 17), rrot(w[i - 2], 19)), rshift(w[i - 2], 10))
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) % 4294967296
        end
        local a, b, c, d, e, f, g, h = H[1], H[2], H[3], H[4], H[5], H[6], H[7], H[8]
        for i = 1, 64 do
            local S1 = bxor(bxor(rrot(e, 6), rrot(e, 11)), rrot(e, 25))
            local ch = bxor(band(e, f), band(bnot(e), g))
            local t1 = (h + S1 + ch + K[i] + w[i]) % 4294967296
            local S0 = bxor(bxor(rrot(a, 2), rrot(a, 13)), rrot(a, 22))
            local maj = bxor(bxor(band(a, b), band(a, c)), band(b, c))
            local t2 = (S0 + maj) % 4294967296
            h = g; g = f; f = e; e = (d + t1) % 4294967296
            d = c; c = b; b = a; a = (t1 + t2) % 4294967296
        end
        H[1] = (H[1] + a) % 4294967296
        H[2] = (H[2] + b) % 4294967296
        H[3] = (H[3] + c) % 4294967296
        H[4] = (H[4] + d) % 4294967296
        H[5] = (H[5] + e) % 4294967296
        H[6] = (H[6] + f) % 4294967296
        H[7] = (H[7] + g) % 4294967296
        H[8] = (H[8] + h) % 4294967296
    end
    local out = {}
    for i = 1, 8 do out[i] = string.format("%08x", H[i]) end
    return table.concat(out)
end

-- FIX: executor-hash used only if it matches the reference implementation
local function sha256(msg)
    if type(crypt) == "table" and type(crypt.hash) == "function" then
        local okTest, testHash = pcall(function() return crypt.hash("sha256", "justteam") end)
        if okTest and type(testHash) == "string" and string.lower(testHash) == sha256_pure("justteam") then
            local ok, h = pcall(function() return crypt.hash("sha256", msg) end)
            if ok and type(h) == "string" and #h > 0 then return string.lower(h) end
        end
    end
    return sha256_pure(msg)
end

local expectedSeal = sha256(
    tostring(env.JUSTTEAM_HWID) .. "|" ..
    tostring(env.JUSTTEAM_TOKEN) .. "|" ..
    tostring(env.JUSTTEAM_LOADED_AT) .. "|" ..
    SECRET
)
if string.lower(tostring(expectedSeal)) ~= string.lower(tostring(env.JUSTTEAM_SEAL)) then
    return _fail("Seal mismatch")
end

