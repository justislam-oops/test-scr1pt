        Config.FlySpeed = v
        saveConfig()
    end)
    makeToggle(Tabs.combat, "Noclip", "NoclipDesc", State.NoclipEnabled, setNoclip)
    makeToggle(Tabs.combat, "InfiniteJump", "InfiniteJumpDesc", State.InfiniteJumpEnabled, setJump)
end

