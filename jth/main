local FOV_PRESETS = { Small = 60, Medium = 120, Large = 200, Ultra = 400 }
local CONFIG_FILE = "justteam_config.json"

local MenuKey = Enum.KeyCode.Insert

local function resolveMenuKey()
    local ok, key = pcall(function() return Enum.KeyCode[Config.MenuKeyName] end)
    if ok and key then MenuKey = key else MenuKey = Enum.KeyCode.Insert end
end

local function saveConfig()
    if type(writefile) ~= "function" then return end
    local data = {}
    for k, v in pairs(Config) do
        local t = type(v)
        if t == "number" or t == "string" or t == "boolean" then data[k] = v end
    end
    pcall(function() writefile(CONFIG_FILE, HttpService:JSONEncode(data)) end)
end

local function loadConfig()
    if type(isfile) ~= "function" or type(readfile) ~= "function" then return end
    local okf, exists = pcall(isfile, CONFIG_FILE)
    if not okf or not exists then return end
    local ok, raw = pcall(readfile, CONFIG_FILE)
    if not ok or type(raw) ~= "string" then return end
    local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok2 or type(data) ~= "table" then return end
    for k, v in pairs(data) do
        if Config[k] ~= nil and type(Config[k]) == type(v) then Config[k] = v end
    end
    CurrentLang = (Config.Language == "EN") and "EN" or "RU"
end

loadConfig()
resolveMenuKey()

--=====================================================================
-- TARGETING CORE
--=====================================================================
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function updateRayFilter()
    local filter = {}
    if Camera then table.insert(filter, Camera) end
    if LP.Character then table.insert(filter, LP.Character) end
    rayParams.FilterDescendantsInstances = filter
end
updateRayFilter()

-- FIX: weak keys -> no memory leak when parts are destroyed
local wallCache = setmetatable({}, { __mode = "k" })
local WALL_TTL = 0.1

local function isVisible(part)
    if not part or not part.Parent then return false end
    local clockNow = os.clock()
    local cached = wallCache[part]
    if cached and (clockNow - cached.t) < WALL_TTL then return cached.v end

    local origin = Camera.CFrame.Position
    local dir = part.Position - origin
    if dir.Magnitude < 0.05 then
        wallCache[part] = { t = clockNow, v = true }
        return true
    end

    local result = Workspace:Raycast(origin, dir, rayParams)
    -- FIX: hit on the target itself / its model counts as visible
    local visible = true
    if result and result.Instance then
        local inst = result.Instance
        visible = (inst == part) or inst:IsDescendantOf(part.Parent)
    end
    wallCache[part] = { t = clockNow, v = visible }
    return visible
end

local function getFovRadius(fov)
    local vp = Camera.ViewportSize
    local scale = vp.Y / 1080
    if scale <= 0 then scale = 1 end
    return fov * scale
end

local function getScreenCenter()
    local vp = Camera.ViewportSize
    return Vector2.new(vp.X * 0.5, vp.Y * 0.5)
end

local TORSO_NAMES = { "UpperTorso", "Torso", "LowerTorso", "HumanoidRootPart" }

local function resolvePart(character, mode)
    if not character then return nil end

    if mode == "Random" then
        local parts = {}
        for _, name in ipairs({ "Head", "UpperTorso", "Torso", "HumanoidRootPart" }) do
            local p = character:FindFirstChild(name)
            if p and p:IsA("BasePart") then table.insert(parts, p) end
        end
        if #parts == 0 then return character:FindFirstChild("HumanoidRootPart") end
        return parts[math.random(1, #parts)]
    end

    if mode == "Nearest" then
        local camPos = Camera.CFrame.Position
        local best, bestDist = nil, math.huge
        for _, p in ipairs(character:GetChildren()) do
            if p:IsA("BasePart") then
                local d = (p.Position - camPos).Magnitude
                if d < bestDist then best, bestDist = p, d end
            end
        end
        return best or character:FindFirstChild("HumanoidRootPart")
    end

    if mode == "Torso" then
        for _, name in ipairs(TORSO_NAMES) do
            local p = character:FindFirstChild(name)
            if p and p:IsA("BasePart") then return p end
        end
    end

    local p = character:FindFirstChild(mode)
    if p and p:IsA("BasePart") then return p end
    return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
end

local function isAlive(plr)
    if not plr or plr == LP then return false end
    local char = plr.Character
    if not char or not char.Parent then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return true
end

local function isTeammate(plr)
    if not LP.Team or not plr.Team then return false end
    return LP.Team == plr.Team
end

-- FIX: returns list + the wall-check flag that belongs to the requested mode
local function findTargets(mode)
    local center = getScreenCenter()
    local fov, maxDist, teamCheck, wallCheck

    if mode == "AimAssist" then
        fov = Config.SilentAimFOV
        maxDist = Config.AimAssistMaxDist
        teamCheck = Config.AimAssistTeamCheck
        wallCheck = Config.AimAssistWallCheck
    else
        fov = Config.SilentAimFOV
        maxDist = Config.MaxTargetDist
        teamCheck = Config.SilentAimTeamCheck
        wallCheck = Config.SilentAimWallCheck
    end

    local radius = getFovRadius(fov)
    local camPos = Camera.CFrame.Position
    local list = {}

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and isAlive(plr) and not (teamCheck and isTeammate(plr)) then
            local part = resolvePart(plr.Character, Config.SilentAimPart)
            if part then
                local worldDist = (part.Position - camPos).Magnitude
                if worldDist <= maxDist then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen and screenPos.Z > 0 then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if dist <= radius then
                            table.insert(list, {
                                plr = plr, part = part,
                                dist = dist, worldDist = worldDist,
                                screen = Vector2.new(screenPos.X, screenPos.Y),
                            })
                        end
                    end
                end
            end
        end
    end

    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list, wallCheck
end

local function findTarget(mode)
    local list, wallCheck = findTargets(mode)
    for _, t in ipairs(list) do
        if (not wallCheck) or isVisible(t.part) then return t end
    end
    return nil
end

local currentTarget = nil
local nextSearch = 0

local function updateTarget(mode)
    local clockNow = os.clock()
    if clockNow < nextSearch then return currentTarget end
    local jitter = Config.JitterMin + math.random() * (Config.JitterMax - Config.JitterMin)
    nextSearch = clockNow + Config.TargetCacheTime + jitter
    currentTarget = findTarget(mode or "SilentAim")
    return currentTarget
end

--=====================================================================
-- SILENT AIM  (FIX: pre-render set / post-render restore)
--=====================================================================
local SILENT_PRE = "JT_" .. randomString(8)
local SILENT_POST = "JT_" .. randomString(8)
local savedCF = nil

local function silentPre()
    if not State.SilentAimEnabled then return end
    local t = updateTarget("SilentAim")
    if not t or not t.part or not t.part.Parent then return end
    savedCF = Camera.CFrame
    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, t.part.Position)
end

local function silentPost()
    if savedCF then
        Camera.CFrame = savedCF
        savedCF = nil
    end
end

local function setSilentAim(enabled)
    State.SilentAimEnabled = enabled
    pcall(function() RunService:UnbindFromRenderStep(SILENT_PRE) end)
    pcall(function() RunService:UnbindFromRenderStep(SILENT_POST) end)
    if enabled then
        RunService:BindToRenderStep(SILENT_PRE, Enum.RenderPriority.Camera.Value + 1, silentPre)
        RunService:BindToRenderStep(SILENT_POST, Enum.RenderPriority.Last.Value + 1, silentPost)
    else
        silentPost()
        currentTarget = nil
    end
end

--=====================================================================
-- AIM ASSIST (FIX: clean exponential smoothing)
--=====================================================================
local aimAssistConn = nil

local function aimStep(dt)
    if not State.AimAssistEnabled then return end
    if Config.AimAssistHoldRMB and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end

    local t = findTarget("AimAssist")
    if not t or not t.part or not t.part.Parent then return end

    local currentCF = Camera.CFrame
    local targetCF = CFrame.lookAt(currentCF.Position, t.part.Position)
    local alpha = clamp(Config.AimAssistSmooth * dt * 60, 0, 1)
    Camera.CFrame = currentCF:Lerp(targetCF, alpha)
end

local function setAimAssist(enabled)
    State.AimAssistEnabled = enabled
    if aimAssistConn then aimAssistConn:Disconnect(); aimAssistConn = nil end
    if enabled then
        aimAssistConn = RunService.RenderStepped:Connect(aimStep)
    end
end

--=====================================================================
-- MOVEMENT
--=====================================================================
local speedConn, noclipConn, jumpConn, flyConn = nil, nil, nil, nil
local noclipStore = {}

local function setSpeed(enabled)
    State.SpeedEnabled = enabled
    if speedConn then speedConn:Disconnect(); speedConn = nil end
    if not enabled then return end
    speedConn = RunService.Heartbeat:Connect(function(dt)
        if not State.SpeedEnabled or State.FlyEnabled then return end
        local char = LP.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hum and hrp and hum.Health > 0 and not hum.Sit and hum.MoveDirection.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (hum.MoveDirection * Config.SpeedValue * dt)
        end
    end)
end

-- FIX: remembers original CanCollide and restores it
local function setNoclip(enabled)
    State.NoclipEnabled = enabled
    if noclipConn then noclipConn:Disconnect(); noclipConn = nil end

    if enabled then
        noclipStore = {}
        noclipConn = RunService.Stepped:Connect(function()
            if not State.NoclipEnabled then return end
            local char = LP.Character
            if not char then return end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    if noclipStore[part] == nil then noclipStore[part] = true end
                    part.CanCollide = false
                end
            end
        end)
    else
        for part, was in pairs(noclipStore) do
            if was and part and part.Parent then
                pcall(function() part.CanCollide = true end)
            end
        end
        noclipStore = {}
    end
end

local function setJump(enabled)
    State.InfiniteJumpEnabled = enabled
    if jumpConn then jumpConn:Disconnect(); jumpConn = nil end
    if not enabled then return end
    jumpConn = UserInputService.JumpRequest:Connect(function()
        if not State.InfiniteJumpEnabled then return end
        local char = LP.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)
end

-- FIX: PlatformStand + clean exit (no fall-through / stuck velocity)
local function setFly(enabled)
    State.FlyEnabled = enabled
    if flyConn then flyConn:Disconnect(); flyConn = nil end

    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if not enabled then
        if hum then pcall(function() hum.PlatformStand = false end) end
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then pcall(function() hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end) end
        return
    end

    if hum then pcall(function() hum.PlatformStand = true end) end

    flyConn = RunService.RenderStepped:Connect(function()
        if not State.FlyEnabled then return end
        local c = LP.Character
        if not c then return end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        local h = c:FindFirstChildOfClass("Humanoid")
        if not hrp then return end
        if h and not h.PlatformStand then pcall(function() h.PlatformStand = true end) end

        local move = Vector3.new(0, 0, 0)
        local cf = Camera.CFrame
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + cf.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - cf.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - cf.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + cf.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then move = move - Vector3.new(0, 1, 0) end

        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        if move.Magnitude > 0 then
            hrp.AssemblyLinearVelocity = move.Unit * Config.FlySpeed
        else
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end)
end

-- FIX: Idled event instead of tick() polling
local idledConn = nil
local function setAntiAfk(enabled)
    Config.AntiAfkEnabled = enabled
    saveConfig()
    if idledConn then return end
    idledConn = LP.Idled:Connect(function()
        if not Config.AntiAfkEnabled then return end
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new(0, 0))
        end)
    end)
    table.insert(Connections, idledConn)
end

--=====================================================================
-- ESP
--=====================================================================
local ScreenGui, Root, MainFrame, uiScale
local Tabs = {}
local FovCircle, FovStroke, TargetStatus, FovInfoLabel, TargetMarker
local ESPHolder = nil
local ESPData = {}
local LastFovRadius, LastViewport, LastTargetName = nil, nil, nil

local function espRoot(char)
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head") or char.PrimaryPart
end

local function billboard(adornee, size, offset, zIndex)
    local gui = Instance.new("BillboardGui")
    gui.Name = "_" .. randomString(8)
    gui.Size = size
    gui.StudsOffset = offset
    gui.AlwaysOnTop = true
    gui.LightInfluence = 0
    gui.MaxDistance = math.huge
    gui.Adornee = adornee
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
    gui.Parent = ESPHolder
    return gui
end

local function createBoxESP(adornee)
    local gui = billboard(adornee, UDim2.new(4.2, 0, 5.6, 0), Vector3.new(0, 0, 0))
    local box = Instance.new("Frame")
    box.Size = UDim2.fromScale(1, 1)
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 0
    box.Parent = gui
    local stroke = Instance.new("UIStroke")
    stroke.Color = COLORS.Accent
    stroke.Thickness = 1.5
    stroke.Parent = box
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = box
    return { gui = gui, stroke = stroke }
end

local function createNameESP(adornee, plr)
    local gui = billboard(adornee, UDim2.new(0, 220, 0, 20), Vector3.new(0, 3.4, 0))
    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = plr.Name
    label.TextColor3 = COLORS.Text
    label.TextStrokeTransparency = 0.25
    label.TextSize = 14
    label.Font = Enum.Font.GothamBold
    label.Parent = gui
    return { gui = gui, label = label }
end

local function createHealthESP(adornee)
    local gui = billboard(adornee, UDim2.new(0, 104, 0, 8), Vector3.new(0, -3.2, 0))
    local bg = Instance.new("Frame")
    bg.Size = UDim2.fromScale(1, 1)
    bg.BackgroundColor3 = Color3.fromRGB(18, 20, 26)
    bg.BorderSizePixel = 0
    bg.Parent = gui
    local bgc = Instance.new("UICorner")
    bgc.CornerRadius = UDim.new(1, 0)
    bgc.Parent = bg
    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(1, 1)
    fill.BackgroundColor3 = COLORS.Green
    fill.BorderSizePixel = 0
    fill.Parent = bg
    local fc = Instance.new("UICorner")
    fc.CornerRadius = UDim.new(1, 0)
    fc.Parent = fill
    return { gui = gui, fill = fill }
end

local function createDistanceESP(adornee)
    local gui = billboard(adornee, UDim2.new(0, 200, 0, 16), Vector3.new(0, 4.5, 0))
    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = ""
    label.TextColor3 = COLORS.Yellow
    label.TextStrokeTransparency = 0.3
    label.TextSize = 12
    label.Font = Enum.Font.GothamMedium
    label.Parent = gui
    return { gui = gui, label = label }
end

-- FIX: no more indexing Instances with .gui (это роняло очистку ESP)
local function destroyESP(plr)
    local data = ESPData[plr]
    if not data then return end
    if data.highlight then pcall(function() data.highlight:Destroy() end) end
    for _, key in ipairs({ "box", "name", "health", "distance" }) do
        local obj = data[key]
        if type(obj) == "table" and obj.gui then
            pcall(function() obj.gui:Destroy() end)
        end
    end
    ESPData[plr] = nil
end

local function applyESP(plr)
    if plr == LP then return end
    destroyESP(plr)
    if not State.ESPEnabled then return end
    if Config.ESPTeamCheck and isTeammate(plr) then return end

    local char = plr.Character
    if not char then return end
    local adornee = espRoot(char)
    if not adornee then return end

    local data = {}

    local h = Instance.new("Highlight")
    h.Name = "_" .. randomString(8)
    h.FillColor = COLORS.Accent
    h.OutlineColor = COLORS.Text
    h.FillTransparency = 0.55
    h.OutlineTransparency = 0.1
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Adornee = char
    h.Parent = ESPHolder
    data.highlight = h

    if Config.ESPBox then data.box = createBoxESP(adornee) end
    if Config.ESPName then data.name = createNameESP(adornee, plr) end
    if Config.ESPHealth then data.health = createHealthESP(adornee) end
    if Config.ESPDistance then data.distance = createDistanceESP(adornee) end

    ESPData[plr] = data
end

local function refreshAllESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then applyESP(plr) end
    end
end

local espUpdateConn = nil
local lastEspUpdate = 0

local function updateESP()
    local clockNow = os.clock()
    if clockNow - lastEspUpdate < 0.033 then return end -- ~30 FPS throttle
    lastEspUpdate = clockNow

    for plr, data in pairs(ESPData) do
        local char = plr.Character
        if not char or not char.Parent then
            destroyESP(plr)
        else
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = espRoot(char)
            local dist = hrp and (Camera.CFrame.Position - hrp.Position).Magnitude or 0
            local inRange = dist <= Config.ESPMaxDistance

            if data.highlight then data.highlight.Enabled = inRange end
            if data.box then
                data.box.gui.Enabled = inRange
                if hum then
                    data.box.stroke.Color = (hum.Health / math.max(hum.MaxHealth, 1) > 0.35) and COLORS.Accent or COLORS.Red
                end
            end
            if data.name then
                data.name.gui.Enabled = inRange
                data.name.label.Text = plr.Name
            end
            if data.health and hum then
                data.health.gui.Enabled = inRange
                local ratio = clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                data.health.fill.Size = UDim2.fromScale(ratio, 1)
                if ratio > 0.6 then
                    data.health.fill.BackgroundColor3 = COLORS.Green
                elseif ratio > 0.3 then
                    data.health.fill.BackgroundColor3 = COLORS.Yellow
                else
                    data.health.fill.BackgroundColor3 = COLORS.Red
                end
            end
            if data.distance then
                data.distance.gui.Enabled = inRange
                data.distance.label.Text = math.floor(dist) .. "m"
            end
        end
    end
end

local function setESP(enabled)
    State.ESPEnabled = enabled
    if enabled then
        refreshAllESP()
        if not espUpdateConn then
            espUpdateConn = RunService.RenderStepped:Connect(updateESP)
        end
    else
        for plr, _ in pairs(ESPData) do destroyESP(plr) end
        ESPData = {}
        if espUpdateConn then espUpdateConn:Disconnect(); espUpdateConn = nil end
    end
end

-- FIX: hook characters of players who were already in the server
local function hookPlayerESP(plr)
    if plr == LP then return end
    connect(plr.CharacterAdded, function()
        task.wait(0.6)
        if State.ESPEnabled then applyESP(plr) end
    end)
    connect(plr.CharacterRemoving, function()
        destroyESP(plr)
    end)
end

for _, plr in ipairs(Players:GetPlayers()) do hookPlayerESP(plr) end
connect(Players.PlayerAdded, hookPlayerESP)
connect(Players.PlayerRemoving, function(plr) destroyESP(plr) end)

--=====================================================================
-- UI HELPERS (PREMIUM)
--=====================================================================
local function addCorner(inst, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = inst
    return c
end

local function addStroke(inst, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or COLORS.Border
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = inst
    return s
end

local function addGradient(inst, c1, c2, rotation)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new(c1, c2)
    g.Rotation = rotation or 0
    g.Parent = inst
    return g
end

local function addPadding(inst, t, b, l, r)
    local p = Instance.new("UIPadding")
    p.PaddingTop = UDim.new(0, t or 0)
    p.PaddingBottom = UDim.new(0, b or 0)
    p.PaddingLeft = UDim.new(0, l or 0)
    p.PaddingRight = UDim.new(0, r or 0)
    p.Parent = inst
    return p
end

local function tween(inst, time, props, style, dir)
    local info = TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out)
    local t = TweenService:Create(inst, info, props)
    t:Play()
    return t
end

local function hoverCard(frame, stroke)
    connect(frame.MouseEnter, function()
        tween(frame, 0.16, { BackgroundColor3 = COLORS.CardHover })
        if stroke then tween(stroke, 0.16, { Transparency = 0.15, Color = COLORS.Accent }) end
    end)
    connect(frame.MouseLeave, function()
        tween(frame, 0.16, { BackgroundColor3 = COLORS.Card })
        if stroke then tween(stroke, 0.16, { Transparency = 0.45, Color = COLORS.Border }) end
    end)
end

local function baseCard(parent, height)
    local frame = create("Frame", {
        Size = UDim2.new(1, 0, 0, height),
        BackgroundColor3 = COLORS.Card,
        BorderSizePixel = 0,
    }, parent)
    addCorner(frame, 10)
    local stroke = addStroke(frame, COLORS.Border, 1, 0.45)
    return frame, stroke
end

--=====================================================================
-- UI CONTROLS
--=====================================================================
local function makeToggle(parent, titleKey, descKey, default, callback)
    local frame, stroke = baseCard(parent, 62)
    hoverCard(frame, stroke)

    create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 9),
        Size = UDim2.new(1, -90, 0, 20),
        Font = Enum.Font.GothamBold,
        Text = L(titleKey),
        TextColor3 = COLORS.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, frame)

    create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 31),
        Size = UDim2.new(1, -90, 0, 22),
        Font = Enum.Font.Gotham,
        Text = L(descKey),
        TextColor3 = COLORS.TextDim,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
    }, frame)

    local btn = create("TextButton", {
        Position = UDim2.new(1, -62, 0.5, -13),
        Size = UDim2.new(0, 46, 0, 26),
        BackgroundColor3 = COLORS.ToggleOff,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
    }, frame)
    addCorner(btn, 13)

    local fill = create("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = COLORS.Accent,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, btn)
    addCorner(fill, 13)
    addGradient(fill, COLORS.Accent, COLORS.Accent2, 0)

    local knob = create("Frame", {
        Position = UDim2.new(0, 3, 0.5, -10),
        Size = UDim2.new(0, 20, 0, 20),
        BackgroundColor3 = COLORS.Knob,
        BorderSizePixel = 0,
        ZIndex = 2,
    }, btn)
    addCorner(knob, 10)

    local state = default and true or false

    local function render(animated)
        local time = animated and 0.18 or 0
        if state then
            tween(fill, time, { BackgroundTransparency = 0 })
            tween(knob, time, { Position = UDim2.new(1, -23, 0.5, -10) }, Enum.EasingStyle.Back)
        else
            tween(fill, time, { BackgroundTransparency = 1 })
            tween(knob, time, { Position = UDim2.new(0, 3, 0.5, -10) }, Enum.EasingStyle.Back)
        end
    end
    render(false)

    connect(btn.MouseButton1Click, function()
        state = not state
        render(true)
        local ok, err = pcall(callback, state)
        if not ok then warn("[JustTeam] toggle error: " .. tostring(err)) end
    end)

    return frame
end

local function makeSlider(parent, titleKey, descKey, min, max, default, suffix, callback)
    local frame, stroke = baseCard(parent, 70)
    hoverCard(frame, stroke)

    create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 8),
        Size = UDim2.new(0.6, 0, 0, 20),
        Font = Enum.Font.GothamBold,
        Text = L(titleKey),
        TextColor3 = COLORS.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, frame)

    create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 27),
        Size = UDim2.new(0.78, 0, 0, 16),
        Font = Enum.Font.Gotham,
        Text = L(descKey),
        TextColor3 = COLORS.TextDim,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, frame)

    local valLabel = create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -76, 0, 8),
        Size = UDim2.new(0, 60, 0, 20),
        Font = Enum.Font.GothamBold,
        Text = tostring(default) .. (suffix or ""),
        TextColor3 = COLORS.Accent,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, frame)

    local bar = create("TextButton", {
        Position = UDim2.new(0, 16, 0, 48),
        Size = UDim2.new(1, -32, 0, 8),
        BackgroundColor3 = Color3.fromRGB(38, 43, 55),
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
    }, frame)
    addCorner(bar, 4)

    local fill = create("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = COLORS.Accent,
        BorderSizePixel = 0,
    }, bar)
    addCorner(fill, 4)
    addGradient(fill, COLORS.Accent, COLORS.Accent2, 0)

    local knob = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.new(0, 15, 0, 15),
        BackgroundColor3 = COLORS.Knob,
        BorderSizePixel = 0,
        ZIndex = 3,
    }, bar)
    addCorner(knob, 8)
    addStroke(knob, COLORS.Accent, 2, 0.2)

    local value = clamp(default, min, max)
    local dragging = false

    local function setAlpha(alpha, fire)
        alpha = clamp(alpha, 0, 1)
        value = math.floor(min + (max - min) * alpha + 0.5)
        valLabel.Text = tostring(value) .. (suffix or "")
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        if fire then pcall(callback, value) end
    end

    local function updateFromX(x)
        local absX = bar.AbsolutePosition.X
        local absW = bar.AbsoluteSize.X
        if absW <= 0 then return end
        setAlpha((x - absX) / absW, true)
    end

    connect(bar.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            tween(knob, 0.12, { Size = UDim2.new(0, 19, 0, 19) })
            updateFromX(input.Position.X)
        end
    end)
    connect(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(input.Position.X)
        end
    end)
    connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then tween(knob, 0.12, { Size = UDim2.new(0, 15, 0, 15) }) end
            dragging = false
        end
    end)

    setAlpha((max > min) and ((value - min) / (max - min)) or 0, false)
    return frame
end

-- options = ordered array { {key = "Small", label = "PresetSmall"}, ... }
local function makeDropdown(parent, titleKey, descKey, options, defaultKey, callback)
    local BASE_H = 92
    local ROW_H = 30
    local frame, stroke = baseCard(parent, BASE_H)
    frame.ClipsDescendants = true

    create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 8),
        Size = UDim2.new(1, -32, 0, 20),
        Font = Enum.Font.GothamBold,
        Text = L(titleKey),
        TextColor3 = COLORS.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, frame)

    create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 27),
        Size = UDim2.new(1, -32, 0, 16),
        Font = Enum.Font.Gotham,
        Text = L(descKey),
        TextColor3 = COLORS.TextDim,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, frame)

    local currentLabel = defaultKey
    for _, o in ipairs(options) do
        if o.key == defaultKey then currentLabel = L(o.label) end
    end

    local button = create("TextButton", {
        Position = UDim2.new(0, 16, 0, 48),
        Size = UDim2.new(1, -32, 0, 32),
        BackgroundColor3 = COLORS.Header,
        BorderSizePixel = 0,
        Font = Enum.Font.GothamMedium,
        Text = currentLabel,
        TextColor3 = COLORS.Text,
        TextSize = 12,
        AutoButtonColor = false,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, frame)
    addCorner(button, 7)
    addStroke(button, COLORS.Border, 1, 0.3)
    addPadding(button, 0, 0, 12, 28)

    local arrow = create("TextLabel", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.new(0, 16, 0, 16),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = "v",
        TextColor3 = COLORS.Accent,
        TextSize = 12,
    }, button)

    local list = create("Frame", {
        Position = UDim2.new(0, 16, 0, 86),
        Size = UDim2.new(1, -32, 0, #options * ROW_H + 4),
        BackgroundColor3 = COLORS.Header,
        BorderSizePixel = 0,
        Visible = false,
    }, frame)
    addCorner(list, 7)
    addStroke(list, COLORS.Border, 1, 0.25)
    addPadding(list, 2, 2, 0, 0)
    local ll = Instance.new("UIListLayout")
    ll.SortOrder = Enum.SortOrder.LayoutOrder
    ll.Parent = list

    local open = false
    local function setOpen(v)
        open = v
        if open then
            list.Visible = true
            tween(frame, 0.2, { Size = UDim2.new(1, 0, 0, BASE_H + #options * ROW_H + 10) })
            tween(arrow, 0.2, { Rotation = 180 })
        else
            tween(frame, 0.2, { Size = UDim2.new(1, 0, 0, BASE_H) })
            tween(arrow, 0.2, { Rotation = 0 })
            task.delay(0.2, function()
                if not open and list and list.Parent then list.Visible = false end
            end)
        end
    end

    for i, opt in ipairs(options) do
        local row = create("TextButton", {
            Size = UDim2.new(1, 0, 0, ROW_H),
            BackgroundColor3 = COLORS.Header,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Font = Enum.Font.GothamMedium,
            Text = L(opt.label),
            TextColor3 = (opt.key == defaultKey) and COLORS.Accent or COLORS.Text,
            TextSize = 11,
            AutoButtonColor = false,
            LayoutOrder = i,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, list)
        addPadding(row, 0, 0, 12, 0)

        connect(row.MouseEnter, function() tween(row, 0.12, { BackgroundTransparency = 0.35, BackgroundColor3 = COLORS.CardHover }) end)
        connect(row.MouseLeave, function() tween(row, 0.12, { BackgroundTransparency = 1 }) end)
        connect(row.MouseButton1Click, function()
            button.Text = L(opt.label)
            for _, other in ipairs(list:GetChildren()) do
                if other:IsA("TextButton") then other.TextColor3 = COLORS.Text end
            end
            row.TextColor3 = COLORS.Accent
            setOpen(false)
            pcall(callback, opt.key)
        end)
    end

    connect(button.MouseButton1Click, function() setOpen(not open) end)
    return frame
end

local function makeButton(parent, titleKey, descKey, btnTextKey, color, callback)
    local frame, stroke = baseCard(parent, 62)
    hoverCard(frame, stroke)

    create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 9),
        Size = UDim2.new(1, -150, 0, 20),
        Font = Enum.Font.GothamBold,
        Text = L(titleKey),
        TextColor3 = COLORS.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, frame)
    create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 31),
        Size = UDim2.new(1, -150, 0, 18),
        Font = Enum.Font.Gotham,
        Text = L(descKey),
        TextColor3 = COLORS.TextDim,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, frame)

    local b = create("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -14, 0.5, 0),
        Size = UDim2.new(0, 120, 0, 34),
        BackgroundColor3 = color or COLORS.AccentDark,
        BorderSizePixel = 0,
        Font = Enum.Font.GothamBold,
        Text = L(btnTextKey),
        TextColor3 = COLORS.Text,
        TextSize = 12,
        AutoButtonColor = false,
    }, frame)
    addCorner(b, 7)
    connect(b.MouseEnter, function() tween(b, 0.15, { BackgroundColor3 = COLORS.Accent }) end)
    connect(b.MouseLeave, function() tween(b, 0.15, { BackgroundColor3 = color or COLORS.AccentDark }) end)
    connect(b.MouseButton1Click, function() pcall(callback) end)
    return frame, b
end

local function sectionLabel(parent, text)
    local l = create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 22),
        Font = Enum.Font.GothamBold,
        Text = string.upper(text),
        TextColor3 = COLORS.TextDim,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, parent)
    return l
end

--=====================================================================
-- MAIN WINDOW
--=====================================================================
local menuOpen = true
local waitingForKey = false
local keyButtonRef = nil
local rebuildUI -- forward declaration

local function setMenuOpen(open, instant)
    menuOpen = open
    if not Root then return end
    if instant then
        Root.Visible = open
        uiScale.Scale = open and 1 or 0.92
        return
    end
    if open then
        Root.Visible = true
        uiScale.Scale = 0.9
        tween(uiScale, 0.26, { Scale = 1 }, Enum.EasingStyle.Back)
        tween(MainFrame, 0.2, { BackgroundTransparency = 0 })
    else
        tween(uiScale, 0.16, { Scale = 0.92 })
        tween(MainFrame, 0.16, { BackgroundTransparency = 0.4 })
        task.delay(0.17, function()
            if not menuOpen and Root then Root.Visible = false end
        end)
    end
end

local function buildGui()
    local parent = (type(gethui) == "function" and select(2, pcall(gethui))) or game:GetService("CoreGui")
    if typeof(parent) ~= "Instance" then parent = game:GetService("CoreGui") end

    ScreenGui = create("ScreenGui", {
        Name = GUI_PREFIX .. randomString(6),
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 999,
    }, parent)

    ESPHolder = create("Folder", { Name = "_" .. randomString(8) }, ScreenGui)

    Root = create("Frame", {
        Name = "Root",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 760, 0, 480),
        BackgroundTransparency = 1,
    }, ScreenGui)

    uiScale = Instance.new("UIScale")
    uiScale.Scale = 0.9
    uiScale.Parent = Root

    -- soft glow shadow
    create("ImageLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 8),
        Size = UDim2.new(1, 90, 1, 90),
        BackgroundTransparency = 1,
        Image = "rbxassetid://6014261993",
        ImageColor3 = Color3.fromRGB(0, 0, 0),
        ImageTransparency = 0.35,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(49, 49, 450, 450),
        ZIndex = 0,
    }, Root)

    MainFrame = create("Frame", {
        Name = "Main",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = COLORS.Bg,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        ZIndex = 1,
    }, Root)
    addCorner(MainFrame, 14)
    local mStroke = addStroke(MainFrame, COLORS.Border, 1.4, 0.15)
    addGradient(MainFrame, Color3.fromRGB(15, 18, 25), Color3.fromRGB(9, 11, 16), 90)

    tween(MainFrame, 0.3, { BackgroundTransparency = 0 })
    tween(uiScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)

    --------------------------------------------------- HEADER
    local header = create("Frame", {
        Size = UDim2.new(1, 0, 0, 62),
        BackgroundColor3 = COLORS.Header,
        BorderSizePixel = 0,
        ZIndex = 2,
    }, MainFrame)
    addCorner(header, 14)
    addGradient(header, Color3.fromRGB(26, 31, 43), Color3.fromRGB(16, 19, 26), 0)
    create("Frame", {
        Position = UDim2.new(0, 0, 1, -14),
        Size = UDim2.new(1, 0, 0, 14),
        BackgroundColor3 = COLORS.Header,
        BorderSizePixel = 0,
        ZIndex = 2,
    }, header)

    local accentLine = create("Frame", {
        Position = UDim2.new(0, 0, 1, -2),
        Size = UDim2.new(1, 0, 0, 2),
        BackgroundColor3 = COLORS.Accent,
        BorderSizePixel = 0,
        ZIndex = 3,
    }, header)
    local alg = addGradient(accentLine, COLORS.Accent, COLORS.Accent2, 0)
    alg.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.5, 0.1),
        NumberSequenceKeypoint.new(1, 1),
    })

    local logo = create("Frame", {
        Position = UDim2.new(0, 18, 0.5, -17),
        Size = UDim2.new(0, 34, 0, 34),
        BackgroundColor3 = COLORS.Accent,
        BorderSizePixel = 0,
        ZIndex = 3,
    }, header)
    addCorner(logo, 9)
    addGradient(logo, COLORS.Accent, COLORS.Accent2, 45)
    create("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Font = Enum.Font.GothamBlack,
        Text = "JT",
        TextColor3 = Color3.fromRGB(8, 14, 24),
        TextSize = 14,
        ZIndex = 4,
    }, logo)

    local title = create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 62, 0, 12),
        Size = UDim2.new(0, 220, 0, 20),
        Font = Enum.Font.GothamBlack,
        Text = "JUST TEAM",
        TextColor3 = COLORS.Text,
        TextSize = 16,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 3,
    }, header)
    addGradient(title, Color3.fromRGB(255, 255, 255), Color3.fromRGB(160, 200, 255), 90)

    create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 62, 0, 31),
        Size = UDim2.new(0, 260, 0, 16),
        Font = Enum.Font.GothamMedium,
        Text = L("BrandSubtitle"),
        TextColor3 = COLORS.Accent,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 3,
    }, header)

    local keyChip = create("TextLabel", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -18, 0.5, 0),
        Size = UDim2.new(0, 118, 0, 26),
        BackgroundColor3 = COLORS.Card,
        BorderSizePixel = 0,
        Font = Enum.Font.GothamMedium,
        Text = "MENU: " .. MenuKey.Name,
        TextColor3 = COLORS.TextDim,
        TextSize = 10,
        ZIndex = 3,
    }, header)
    addCorner(keyChip, 13)
    addStroke(keyChip, COLORS.Border, 1, 0.3)

    -- drag only by header (FIX: раньше тянулось всё окно, ломая клики)
    local dragging, dragStart, startPos = false, nil, nil
    connect(header.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Root.Position
        end
    end)
    connect(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            Root.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    --------------------------------------------------- SIDEBAR
    local sidebar = create("Frame", {
        Position = UDim2.new(0, 0, 0, 62),
        Size = UDim2.new(0, 178, 1, -62),
        BackgroundColor3 = COLORS.Sidebar,
        BorderSizePixel = 0,
    }, MainFrame)
    addGradient(sidebar, Color3.fromRGB(18, 21, 29), Color3.fromRGB(12, 14, 20), 90)

    create("Frame", {
        Position = UDim2.new(1, -1, 0, 0),
        Size = UDim2.new(0, 1, 1, 0),
        BackgroundColor3 = COLORS.Border,
        BorderSizePixel = 0,
    }, sidebar)

    local navHolder = create("Frame", {
        Position = UDim2.new(0, 12, 0, 16),
        Size = UDim2.new(1, -24, 1, -32),
        BackgroundTransparency = 1,
    }, sidebar)

    local indicator = create("Frame", {
        Size = UDim2.new(0, 3, 0, 22),
        Position = UDim2.new(0, -12, 0, 10),
        BackgroundColor3 = COLORS.Accent,
        BorderSizePixel = 0,
        ZIndex = 3,
    }, navHolder)
    addCorner(indicator, 2)
    addGradient(indicator, COLORS.Accent, COLORS.Accent2, 90)

    local ITEM_H, ITEM_GAP = 42, 8
    local navButtons = {}

    local function navButton(text, index)
        local b = create("TextButton", {
            BackgroundColor3 = COLORS.Card,
            BackgroundTransparency = 0.35,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 0, 0, (index - 1) * (ITEM_H + ITEM_GAP)),
            Size = UDim2.new(1, 0, 0, ITEM_H),
            Font = Enum.Font.GothamMedium,
            Text = text,
            TextColor3 = COLORS.TextDim,
            TextSize = 13,
            AutoButtonColor = false,
        }, navHolder)
        addCorner(b, 9)
        addPadding(b, 0, 0, 14, 0)
        b.TextXAlignment = Enum.TextXAlignment.Left
        navButtons[index] = b
        return b
    end

    local tabOrder = { "info", "combat", "visual", "settings" }
    local btnInfo = navButton(L("Info"), 1)
    local btnCombat = navButton(L("Combat"), 2)
    local btnVisual = navButton(L("Visual"), 3)
    local btnSettings = navButton(L("Settings"), 4)

    --------------------------------------------------- CONTENT
    local content = create("Frame", {
        Position = UDim2.new(0, 178, 0, 62),
        Size = UDim2.new(1, -178, 1, -62),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    }, MainFrame)

    local function makeTab(name)
        local s = create("ScrollingFrame", {
            Name = name,
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            ScrollBarThickness = 4,
            ScrollBarImageColor3 = COLORS.Accent,
            ScrollBarImageTransparency = 0.3,
            Visible = false,
        }, content)
        addPadding(s, 18, 24, 18, 14)
        local l = Instance.new("UIListLayout")
        l.Padding = UDim.new(0, 10)
        l.SortOrder = Enum.SortOrder.LayoutOrder
        l.Parent = s
        return s
    end

    Tabs.info = makeTab("InfoTab")
    Tabs.combat = makeTab("CombatTab")
    Tabs.visual = makeTab("VisualTab")
    Tabs.settings = makeTab("SettingsTab")

    local activeIndex = 1
    local function switch(index)
        activeIndex = index
        for i, key in ipairs(tabOrder) do
            local tab = Tabs[key]
            local btn = navButtons[i]
            if i == index then
                tab.Visible = true
                tab.Position = UDim2.new(0, 14, 0, 0)
                tween(tab, 0.22, { Position = UDim2.new(0, 0, 0, 0) })
                tween(btn, 0.18, { BackgroundTransparency = 0, TextColor3 = COLORS.Text, BackgroundColor3 = COLORS.CardHover })
            else
                tab.Visible = false
                tween(btn, 0.18, { BackgroundTransparency = 0.35, TextColor3 = COLORS.TextDim, BackgroundColor3 = COLORS.Card })
            end
        end
        tween(indicator, 0.25, { Position = UDim2.new(0, -12, 0, (index - 1) * (ITEM_H + ITEM_GAP) + 10) }, Enum.EasingStyle.Back)
    end

    connect(btnInfo.MouseButton1Click, function() switch(1) end)
    connect(btnCombat.MouseButton1Click, function() switch(2) end)
    connect(btnVisual.MouseButton1Click, function() switch(3) end)
    connect(btnSettings.MouseButton1Click, function() switch(4) end)

    for i, b in ipairs(navButtons) do
        connect(b.MouseEnter, function()
            if i ~= activeIndex then tween(b, 0.14, { BackgroundTransparency = 0.1, TextColor3 = COLORS.Text }) end
        end)
        connect(b.MouseLeave, function()
            if i ~= activeIndex then tween(b, 0.14, { BackgroundTransparency = 0.35, TextColor3 = COLORS.TextDim }) end
        end)
    end

    switch(1)
    return keyChip
end

