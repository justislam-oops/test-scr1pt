local function buildWatermark()
    local wm = create("Frame", {
        Name = "_" .. randomString(8),
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -14, 0, 14),
        Size = UDim2.new(0, 238, 0, 74),
        BackgroundColor3 = COLORS.Header,
        BackgroundTransparency = 0.1,
        BorderSizePixel = 0,
    }, ScreenGui)
    addCorner(wm, 10)
    addGradient(wm, Color3.fromRGB(24, 29, 40), Color3.fromRGB(14, 17, 24), 90)
    local s = addStroke(wm, COLORS.Accent, 1.2, 0.55)

    local bar = create("Frame", {
        Size = UDim2.new(0, 3, 1, -18),
        Position = UDim2.new(0, 9, 0, 9),
        BackgroundColor3 = COLORS.Accent,
        BorderSizePixel = 0,
    }, wm)
    addCorner(bar, 2)
    addGradient(bar, COLORS.Accent, COLORS.Accent2, 90)

    local titleLbl = create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 20, 0, 7),
        Size = UDim2.new(1, -30, 0, 18),
        Font = Enum.Font.GothamBlack,
        Text = "JUST TEAM  V4.0",
        TextColor3 = COLORS.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, wm)
    addGradient(titleLbl, Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 195, 255), 90)

    local line1 = create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 20, 0, 28),
        Size = UDim2.new(1, -30, 0, 16),
        Font = Enum.Font.GothamMedium,
        Text = "FPS: -- | Ping: -- | " .. L("StatPlayers") .. ": --",
        TextColor3 = COLORS.TextDim,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, wm)

    local line2 = create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 20, 0, 46),
        Size = UDim2.new(1, -30, 0, 16),
        Font = Enum.Font.GothamMedium,
        Text = "MENU: " .. MenuKey.Name,
        TextColor3 = COLORS.Accent,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, wm)

    -- FIX: нормальный подсчёт FPS (без RenderStepped:Wait() внутри цикла)
    local frames, acc, fps = 0, 0, 0
    connect(RunService.RenderStepped, function(dt)
        frames = frames + 1
        acc = acc + dt
        if acc >= 1 then
            fps = math.floor(frames / acc + 0.5)
            frames, acc = 0, 0
            local ping = 0
            pcall(function() ping = math.floor((LP:GetNetworkPing() or 0) * 1000) end)
            line1.Text = "FPS: " .. fps .. " | Ping: " .. ping .. "ms | " .. L("StatPlayers") .. ": " .. #Players:GetPlayers()
            line2.Text = "MENU: " .. MenuKey.Name
        end
    end)
end

